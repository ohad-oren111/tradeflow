# IBKR connection
IBKR_HOST=127.0.0.1
IBKR_PORT=4002              # paper gateway; live = 4001
IBKR_CLIENT_ID=10           # feed; broker uses IBKR_CLIENT_ID + 1 per §0.5.T1
IBKR_CLIENT_ID_HEALTHCHECK=98   # used by scripts/healthcheck.py
IBKR_CLIENT_ID_SMOKE=99         # used by scripts/test_ib_connect.py
IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_TOTP_SECRET=
IBKR_PAPER_ACCOUNT=DUQ...   # paper account; prefix is DUQ per Session 3 probe (2026-05-20)
IBKR_LIVE_ACCOUNT=U...

# IB Gateway container tuning (gnzsnz/ib-gateway). docker-compose passes
# IBKR_USERNAME/IBKR_PASSWORD through as TWS_USERID/TWS_PASSWORD.
TWOFA_TIMEOUT_ACTION=exit
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
AUTO_RESTART_TIME=11:30 PM
TIME_ZONE=Etc/UTC
READ_ONLY_API=no
BYPASS_WARNING=yes

# Override secrets dir for docker compose env_file (default /home/tradeflow/.tradeflow-secrets)
# TRADEFLOW_SECRETS_DIR=/home/tradeflow/.tradeflow-secrets

# Trading mode: paper | live
TRADING_MODE=paper

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Telegram (Phase 5 — leave blank to no-op the stubs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
