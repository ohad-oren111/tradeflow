# IBKR connection
IBKR_HOST=127.0.0.1
IBKR_PORT=4002              # paper gateway; live = 4001
IBKR_CLIENT_ID=10           # feed; broker uses IBKR_CLIENT_ID + 1 per §0.5.T1
IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_TOTP_SECRET=
IBKR_PAPER_ACCOUNT=DU...
IBKR_LIVE_ACCOUNT=U...

# Trading mode: paper | live
TRADING_MODE=paper

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Telegram (Phase 5 — leave blank to no-op the stubs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
